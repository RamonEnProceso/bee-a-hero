[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.1, 0.07, 0.04, 0.96)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 28.0
content_margin_right = 28.0
content_margin_top = 22.0
content_margin_bottom = 22.0

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 2
script = ExtResource("1_script")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
