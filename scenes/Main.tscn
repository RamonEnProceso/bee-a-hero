[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\n\nuniform float radius : hint_range(0.0, 1.0) = 0.45;\nuniform float softness : hint_range(0.0, 1.0) = 0.5;\nuniform float intensity : hint_range(0.0, 1.0) = 0.65;\n\nvoid fragment() {\n\tfloat dist = distance(UV, vec2(0.5));\n\tfloat vignette = smoothstep(radius, radius + softness, dist);\n\tCOLOR = vec4(0.0, 0.0, 0.0, vignette * intensity);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
