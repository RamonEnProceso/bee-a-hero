[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dimmer"]
bg_color = Color(0, 0, 0, 0.6)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.1, 0.07, 0.04, 0.96)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 28.0
content_margin_right = 28.0
content_margin_top = 20.0
content_margin_bottom = 20.0

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.09, 0.05, 1)

[node name="Menu" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Menu"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Menu/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_colors/font_outline_color = Color(0.35, 0.24, 0.06, 1)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 64
text = "Bee a Hero"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Menu/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.85)
theme_override_font_sizes/font_size = 20
text = "Construí y defendé el panal"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Menu/VBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="JugarButton" type="Button" parent="Menu/VBox"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Jugar"

[node name="ComoJugarButton" type="Button" parent="Menu/VBox"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Cómo jugar"

[node name="HowToPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dimmer")

[node name="Center" type="CenterContainer" parent="HowToPanel"]
layout_mode = 2

[node name="Card" type="PanelContainer" parent="HowToPanel/Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="VBox" type="VBoxContainer" parent="HowToPanel/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HowToTitle" type="Label" parent="HowToPanel/Center/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 36
text = "Cómo jugar"
horizontal_alignment = 1

[node name="HowToText" type="Label" parent="HowToPanel/Center/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 20
text = "Moverte: WASD o flechas\nDisparar: ESPACIO (apuntás con el mouse)\nConstruir: arrastrá una tarjeta de la derecha al panal\nSolo construís cerca de la abeja\nRecolectá miel para construir más"
horizontal_alignment = 1

[node name="CerrarButton" type="Button" parent="HowToPanel/Center/Card/VBox"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Cerrar"
